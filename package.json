{
  "name": "mono-repo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "postinstall": "npx --yes --package=lightningcss lightningcss --version",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "start": "turbo run dev"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.8.3"
  },
  "optionalDependencies": {
  "sharp": "^0.33.0"
},

  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "openai": "^5.19.1",
    "react-icons": "^5.5.0",
    "sharp": "^0.34.3",
    "ws": "^8.18.3"
  }
}
